{
  "manifest_version": 3,
  "name": "Digital Wellbeing",
  "version": "1.0.1",
  "description": "Track time spent on websites in Firefox",

  "permissions": [
    "tabs",
    "storage"
  ],

  "background": {
    "scripts": ["background.js"]
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Digital Wellbeing"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "digital-wellbeing-tracker@tepis450.addon",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}